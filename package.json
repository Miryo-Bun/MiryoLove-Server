{
  "name": "miryolove-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write src tests prisma README.md README.ru.md docker-compose.yml package.json tsconfig.json eslint.config.js prettier.config.js prisma.config.ts",
    "format:check": "prettier --check src tests prisma README.md README.ru.md docker-compose.yml package.json tsconfig.json eslint.config.js prettier.config.js prisma.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/require-migration-url.js && prisma migrate dev",
    "db:deploy": "node scripts/require-migration-url.js && prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.14",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "minimatch": "^11.0.1",
    "mysql2": "^3.24.5"
  }
}
