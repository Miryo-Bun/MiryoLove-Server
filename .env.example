NODE_ENV=development
PORT=3001
# Runtime credentials; URL-encode the password if it contains reserved characters.
DATABASE_URL=postgresql://miryo_app_runtime:replace-me@localhost:5432/miryolove?schema=public
# Used only by the explicit Prisma migration commands, never by the HTTP runtime.
MIGRATION_DATABASE_URL=postgresql://miryo_app_migrator:replace-me@localhost:5432/miryolove?schema=public
POSTGRES_USER=miryo_user
POSTGRES_PASSWORD=
POSTGRES_DB=miryolove
POSTGRES_PORT=5432
POSTGRES_APP_USER=miryo_app_runtime
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_USER=miryo_app_migrator
POSTGRES_MIGRATOR_PASSWORD=
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:3001/api/auth/yandex/callback
JSON_BODY_LIMIT=1mb
AI_RUNTIME_PYTHON=/mnt/Manchild/Project/MiryoLove/MiryoLove AI/.venv/bin/python
AI_RUNTIME_SCRIPT=/mnt/Manchild/Project/MiryoLove/MiryoLove AI/miryolove_ai.py
MIRYO_MODEL_PATH=/mnt/Tears/MiryoLove AI/Qwen/miryo_merged_7b
MIRYOWIKI_API=https://wiki.miryolove.org/api.php
MIRYOWIKI_URL=https://wiki.miryolove.org
AI_RUNTIME_TIMEOUT_MS=1200000
AI_MAX_PENDING_REQUESTS=5
AI_MAX_NEW_TOKENS=1700
AI_MAX_INPUT_CHARS=12000
AI_MAX_HISTORY_MESSAGES=32
AI_MAX_SOURCE_CHARS=2400
AI_CONTEXT_TOKENS=0
AI_TEMPERATURE=0.7
AI_TOP_P=0.8
AI_DO_SAMPLE=true
AI_REPETITION_PENALTY=1.05
